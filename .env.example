# Copiar a .env para desarrollo. En producción se cargan en Coolify (nunca en el repo).

# Base de datos (en Coolify: la URL interna del PostgreSQL)
DATABASE_URL=postgres://usuario:contrasena@localhost:5432/montana

# Dirección pública de la web
SITE_URL=http://localhost:3000

# Login del panel (Better Auth)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Primer usuario del panel (la semilla lo crea si no existe; después se cambia la contraseña desde el panel)
ADMIN_EMAIL=
ADMIN_NOMBRE=
ADMIN_PASSWORD=

# Protege las tareas programadas de Coolify (enviar emails, ocultar promos vencidas)
CRON_SECRET=

# Fotos que sube la dueña (en Coolify: volumen persistente montado en /data/archivos)
ARCHIVOS_DIR=./.data/archivos

# Para guardar los pedidos sin guardar la IP de quien pide
IP_HASH_SECRETO=

TZ=America/Asuncion

# Emails de aviso de pedidos nuevos
RESEND_API_KEY=
EMAIL_FROM="Montana Helados <avisos@montanahelados.nogashopp.com>"
